{
  "name": "app-base",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "./.cursor/scripts/cloud-agent-install.sh",
  "start": "./.cursor/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 5050 }
  ]
}
