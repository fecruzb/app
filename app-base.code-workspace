// Generated from .vscode/settings.json — that file is canonical.
// The duplication is required: once a window is opened through a
// .code-workspace file, VS Code ignores window-scoped settings coming from
// a folder's .vscode/settings.json (colors, icon theme, explorer, git,
// terminal env, tsdk, schemas). Re-sync by hand when settings.json changes.
{
  "folders": [
    {
      "path": ".",
      "name": "app-base",
    },
  ],
  "settings": {
    "peacock.color": "#0f766e",
    "workbench.colorCustomizations": {
      "activityBar.activeBorder": "#5eead4",
      "activityBar.background": "#0f766e",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#5eead4",
      "activityBarBadge.foreground": "#15202b",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#0f766e",
      "statusBar.background": "#115e59",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#0f766e",
      "statusBarItem.remoteBackground": "#115e59",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#0f766e",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#0f766e99",
      "titleBar.inactiveForeground": "#e7e7e799",
    },
    "workbench.iconTheme": "material-icon-theme",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit",
    },
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.stickyScroll.enabled": true,
    "editor.linkedEditing": true,
    "editor.quickSuggestions": {
      "strings": "on",
    },
    "editor.rulers": [100],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[tailwindcss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[yaml]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.preferences.preferTypeOnlyAutoImports": true,
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "css.lint.unknownAtRules": "ignore",
    "tailwindCSS.experimental.classRegex": [
      ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
      ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ],
    "terminal.integrated.env.osx": {
      "npm_config_devdir": null,
      "NPM_CONFIG_DEVDIR": null,
    },
    "terminal.integrated.env.linux": {
      "npm_config_devdir": null,
      "NPM_CONFIG_DEVDIR": null,
    },
    "terminal.integrated.env.windows": {
      "npm_config_devdir": null,
      "NPM_CONFIG_DEVDIR": null,
    },
    "git.autofetch": true,
    "git.openRepositoryInParentFolders": "always",
    "git.branchProtection": ["main"],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.types.ts",
      "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx",
      "package.json": "package-lock.json, tsconfig.json, tsconfig.*.json, vite.config.*, vitest.config.*, drizzle.config.*, components.json, .oxlintrc.json, eslint.config.*, .eslintrc.*, .prettierrc*, .prettierignore, .editorconfig, .npmrc, .node-version, turbo.json, knip.json, typedoc.json, .gitignore",
    },
    "explorer.sortOrder": "foldersNestsFiles",
    "search.useIgnoreFiles": true,
    "search.followSymlinks": false,
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/coverage": true,
      "**/*.tsbuildinfo": true,
      "**/test-results": true,
      "**/playwright-report": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/coverage": true,
      "**/*.tsbuildinfo": true,
      "**/package-lock.json": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.next/**": true,
      "**/.turbo/**": true,
    },
    "yaml.schemas": {
      "https://render.com/schema/render.yaml.json": "render.yaml",
    },
  },
}
