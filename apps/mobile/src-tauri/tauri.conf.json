{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Base",
  "version": "0.1.0",
  "identifier": "com.appbase.mobile",
  "build": {
    "beforeDevCommand": "npm run sync:brand && npm run vite",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run sync:brand && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "App Base"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
