# Optional — set by Tauri desktop/mobile builds. Leave unset for the browser
# SPA (relative /api, same-origin cookies via the API-served dist).
# VITE_API_URL=http://localhost:5050
# VITE_API_URL=https://your-app.onrender.com

# Optional — "hash" for Tauri custom-protocol routing; default is browser history.
# VITE_ROUTER=hash
