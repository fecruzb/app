{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Base",
  "version": "0.1.0",
  "identifier": "com.appbase.desktop",
  "build": {
    "beforeDevCommand": "npm run sync:brand && npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sync:brand && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "App Base",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  },
