{
  "name": "@app/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "vite": "vite",
    "sync:brand": "node ../../scripts/sync-brand.mjs",
    "build": "tsc --noEmit -p tsconfig.node.json && vite build",
    "tauri": "tauri",
    "release": "tauri build",
    "release:mac": "tauri build",
    "release:mac:universal": "tauri build --target universal-apple-darwin",
    "release:win": "tauri build --bundles nsis",
    "release:linux": "tauri build --bundles appimage",
    "release:open": "open src-tauri/target/release/bundle/dmg",
    "typecheck": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@app/web": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
