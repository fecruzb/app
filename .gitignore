node_modules/
dist/
.env
.env.local
.turbo/
*.log
.DS_Store

# Local-only demo password written by `db:seed` when SEED_DEMO_PASSWORD is unset
apps/api/.seed-demo-password

# Local MCP client config may hold API keys — keep a personal copy, never commit.
.cursor/mcp.json

# Local media fallback (only used when R2 isn't configured) — ignore uploads,
# but keep committed brand assets under public/brand/.
/apps/web/public/*
!/apps/web/public/brand/

# Tauri / Cargo build artifacts (keep Cargo.lock committed)
**/src-tauri/target/
**/src-tauri/gen/schemas/
apps/desktop/dist/
apps/mobile/dist/
apps/desktop/.env.production
apps/mobile/.env.production
