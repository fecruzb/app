# API
PORT=5000
DATABASE_URL=postgres://app:app@localhost:5442/app_base
APP_URL=http://localhost:3000

# E-mail (sem RESEND_API_KEY os e-mails são logados no console)
RESEND_API_KEY=
MAIL_FROM=App Base <onboarding@resend.dev>

# Open AI
OPENAI_API_KEY=

# Agente (sem OPENAI_API_KEY o botão do assistente some do app)
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini

# Desligue para operar apenas por convite
SELF_SIGNUP_ENABLED=true
