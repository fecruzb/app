# API
# On macOS, AirPlay often claims :5000 — use 5050 (or another free port) for local Tauri.
PORT=5050
DATABASE_URL=postgres://app:app@localhost:5442/app_base
APP_URL=http://localhost:3000

# Email (without RESEND_API_KEY, emails are logged to the console)
RESEND_API_KEY=
# Defaults to brand.defaultMailFrom in packages/shared/src/brand.ts when unset.
MAIL_FROM=App Base <onboarding@resend.dev>

# Agent (without OPENAI_API_KEY the assistant button disappears from the app)
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
IMAGE_MODEL=gpt-image-1-mini
# AI monthly caps come from the plan catalog (apps/api/src/domains/billing/plans.ts)

# Turn off to operate invite-only
SELF_SIGNUP_ENABLED=true

# Comma-separated emails that are always platform admins once email-verified
# PLATFORM_ADMIN_EMAILS=you@example.com

# NODE_ENV=development

# Image storage (Cloudflare R2). Without these four the API writes images to
# the local filesystem instead (dev only — Render's disk is ephemeral).
# CLOUDFLARE_S3_API=https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_MEDIA_BUCKET=app
# R2_PUBLIC_BASE_URL=https://<hash>.r2.dev
# Optional local override for the filesystem media root (defaults under apps/web/public)
# MEDIA_DIR=

# Demo user password for `npm run db:seed` (when unset, seed prints a random one)
# SEED_DEMO_PASSWORD=

# Credentialed CORS for Tauri shells + local desktop/mobile Vite (comma-separated).
# Leave unset for browser-only same-origin deploys.
# CORS_ORIGIN=http://localhost:1420,http://localhost:1422,http://localhost:5050,tauri://localhost,https://tauri.localhost
# Desktop/mobile must use VITE_API_URL=http://localhost:<PORT> (not 127.0.0.1) so
# SameSite=None; Secure session cookies stick in the Tauri WKWebView.

# Desktop release publish reuses CLOUDFLARE_* / R2_PUBLIC_BASE_URL above
# (artifacts under desktop-releases/ in the same bucket). Signing key for CI/local:
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
